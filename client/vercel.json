{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].js": {
      "includeFiles": "_server/**",
      "maxDuration": 30
    },
    "api/gallery-og.js": {
      "includeFiles": "{dist/index.html,_server/**}",
      "maxDuration": 10
    },
    "api/gallery-thumbnail.js": {
      "includeFiles": "_server/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/gallery/:id",
      "destination": "/api/gallery-og?id=:id"
    },
    {
      "source": "/og-thumb/:id",
      "destination": "/api/gallery-thumbnail?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
