{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/gallery-og.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/gallery/:id",
      "destination": "/api/gallery-og?id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "https://changil-church-website-backend-f3cef88b0d96.herokuapp.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
